# ==============================================================================
# QuickBite Support Agent & ControlPlane.ai Testing Environment (Template)
# ==============================================================================
# Copy this file to .env and fill in your secrets.

# ── Gemini / LLM API Secrets ──────────────────────────────────────────────────
# Get your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Optional: Other LLM provider keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── ControlPlane.ai Endpoints & Credentials ───────────────────────────────────
CONTROLPLANE_BASE_URL=https://api.controlplane.ai
CONTROLPLANE_API_KEY=your_controlplane_api_key_here
CONTROLPLANE_PROJECT_ID=default_project
CONTROLPLANE_ENVIRONMENT=development
CONTROLPLANE_TELEMETRY_ENDPOINT=https://telemetry.controlplane.ai/v1/metrics
CONTROLPLANE_LOGS_ENDPOINT=https://telemetry.controlplane.ai/v1/logs

# ── MCP Server Configuration & Network Endpoints ──────────────────────────────
MCP_HOST=127.0.0.1
MCP_PORT=8765
MCP_SERVER_URL=http://127.0.0.1:8765

# ── Support Agent Business Rules & Proxy Thresholds ───────────────────────────
REFUND_AUTO_APPROVE_LIMIT=200.0
ESCALATION_SENTIMENT_THRESHOLD=0.35
PROXY_AUDIT_LOG=true

# ── Internal Helpline / Webhook Endpoints ─────────────────────────────────────
HELPLINE_GENERAL=+1-800-FOOD-001
HELPLINE_REFUNDS=+1-800-FOOD-002
HELPLINE_SAFETY=+1-800-FOOD-003
ESCALATION_WEBHOOK_URL=https://hooks.slack.com/services/your/custom/webhook
