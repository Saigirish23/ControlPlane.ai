# ControlPlane.ai — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Google Gemini API Key (required for live agent)
GEMINI_API_KEY=

# Gemini Model (default: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Proxy / Guard settings
REFUND_AUTO_APPROVE_LIMIT=200.0
ESCALATION_SENTIMENT_THRESHOLD=0.35
PROXY_AUDIT_LOG=true

# MCP Server Host / Port
MCP_HOST=127.0.0.1
MCP_PORT=8765

# Helpline numbers (demo/mock)
HELPLINE_GENERAL=+1-800-FOOD-001
HELPLINE_REFUNDS=+1-800-FOOD-002
HELPLINE_SAFETY=+1-800-FOOD-003
