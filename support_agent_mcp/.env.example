# Copy this file to .env and fill in your values
# Then run: python -m support_agent_mcp.cli

# ── Required ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional overrides (defaults shown) ──────────────────────────────────────
GEMINI_MODEL=gemini-3.5-flash

# Max refund amount auto-approved without human review (in INR)
REFUND_AUTO_APPROVE_LIMIT=200.0

# Sentiment score below which proxy flags customer as upset (0.0–1.0)
ESCALATION_SENTIMENT_THRESHOLD=0.35

# MCP server host/port (for future HTTP transport)
MCP_HOST=127.0.0.1
MCP_PORT=8765

# Enable proxy audit logging to terminal
PROXY_AUDIT_LOG=true

# Helpline numbers
HELPLINE_GENERAL=+1-800-FOOD-001
HELPLINE_REFUNDS=+1-800-FOOD-002
HELPLINE_SAFETY=+1-800-FOOD-003
